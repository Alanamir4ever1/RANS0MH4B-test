-- State machine
H.S = {R="READY", L="LOADING", D="LOADED", E="ERROR"}
H.makeSM = function(ui, lbl, rh, lh, dh, eh)
    local state = H.S.R
    local dots = nil
    local function stopDots() if dots then pcall(function() task.cancel(dots) end); dots = nil end end
    local function setCol(c1,c2,h1,h2,st)
        ui.g.Color = ColorSequence.new({ColorSequenceKeypoint.new(0,c1), ColorSequenceKeypoint.new(1,c2)})
        ui.o.Color = ColorSequence.new({ColorSequenceKeypoint.new(0,h1), ColorSequenceKeypoint.new(1,h2)})
        H.tw(ui.sk, {Transparency = st or 0.3}, 0.4)
    end
    local function set(s)
        state = s; stopDots()
        local B = {T.accent, T.aDeep, T.aHi, T.emberHi}
        if s == H.S.R then
            ui.t.Text = lbl; setCol(B[1],B[2],B[3],B[4], 0.75)
            ui.h.Text = rh; ui.h.TextColor3 = T.t2
        elseif s == H.S.L then
            setCol(T.s3, T.s2, T.accent, T.ember, 0.5)
            ui.h.Text = lh; ui.h.TextColor3 = T.warn
            dots = task.spawn(function()
                local n = 0
                while state == H.S.L do
                    n = (n%3)+1; ui.t.Text = "LOADING"..string.rep(".",n); task.wait(0.3)
                end
            end)
        elseif s == H.S.D then
            ui.t.Text = "INJECTED"; setCol(T.ember, T.accent, T.aHi, T.emberHi, 0.4)
            ui.h.Text = dh; ui.h.TextColor3 = T.ember
        elseif s == H.S.E then
            ui.t.Text = "RETRY"; setCol(T.aDeep, T.s0, T.danger, T.aDeep, 0.4)
            ui.h.Text = eh; ui.h.TextColor3 = T.danger
        end
    end
    local sm = {
        get = function() return state end,
        ready = function() set(H.S.R) end,
        loading = function() set(H.S.L) end,
        loaded = function() set(H.S.D) end,
        error = function() set(H.S.E) end,
        refresh = function() set(state) end,
    }
    set(H.S.R)
    return sm
end

-- Inject
H.doInject = function(sm, url, name)
    if sm.get() == H.S.L or sm.get() == H.S.D then return end
    sm.loading()
    task.spawn(function()
        local ok, err = pcall(function()
            loadstring(H.fetch(url))()
        end)
        if ok then sm.loaded()
        else
            warn("[A-90] "..name.." fail: "..tostring(err))
            sm.error(); task.wait(3)
            if sm.get() == H.S.E then sm.ready() end
        end
    end)
end

