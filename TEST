local GLITCH_CHARS = "!@#$%^&*<>?/\\|=+~0123456789ABCDEF"
local function scramble(text, count)
    count = count or 1
    local chars = {}
    for i = 1, #text do chars[i] = text:sub(i, i) end
    for _ = 1, count do
        local idx = math.random(1, #chars)
        if chars[idx] ~= " " then
            chars[idx] = GLITCH_CHARS:sub(math.random(1, #GLITCH_CHARS), math.random(1, #GLITCH_CHARS))
        end
    end
    return table.concat(chars)
end

local function corner(inst, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = inst; return c
end
local function stroke(inst, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.new(1,1,1); s.Thickness = thickness or 1
    s.Transparency = transparency or 0; s.Parent = inst
    return s
end
local function tween(inst, props, dur, style, dir)
    local info = TweenInfo.new(dur or 0.2, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
    local tw = TweenService:Create(inst, info, props); tw:Play(); return tw
end
local function grad(inst, colors, rotation, transparency)
    local g = Instance.new("UIGradient")
    local kp = {}
    for i, c in ipairs(colors) do
        table.insert(kp, ColorSequenceKeypoint.new((i-1)/(#colors-1), c))
    end
    g.Color = ColorSequence.new(kp); g.Rotation = rotation or 0
    if transparency then
        local tp = {}
        for i, t in ipairs(transparency) do
            table.insert(tp, NumberSequenceKeypoint.new((i-1)/(#transparency-1), t))
        end
        g.Transparency = NumberSequence.new(tp)
    end
    g.Parent = inst
    return g
end

