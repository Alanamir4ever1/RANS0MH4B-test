    local track = Instance.new("TextButton")
    track.Size = UDim2.new(0, 300, 0, 8)
    track.Position = UDim2.new(0, 26, 0, yPos + 11)
    track.BackgroundColor3 = T.surface3
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.ZIndex = 10
    track.Parent = parent
    corner(track, 4)

    local initRel = math.clamp(customRGB[chanKey] / 255, 0, 1)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(initRel, 0, 1, 0)
    fill.BackgroundColor3 = channelColor
    fill.BorderSizePixel = 0
    fill.ZIndex = 11
    fill.Parent = track
    corner(fill, 4)

    local handle = Instance.new("Frame")
    handle.Size = UDim2.new(0, 14, 0, 14)
    handle.Position = UDim2.new(initRel, -7, 0.5, -7)
    handle.BackgroundColor3 = Color3.new(1, 1, 1)
    handle.BorderSizePixel = 0
    handle.ZIndex = 12
    handle.Parent = track
    corner(handle, 999)
    stroke(handle, channelColor, 2, 0)

    local num = Instance.new("TextLabel")
    num.Size = UDim2.new(0, 34, 0, rowH)
    num.Position = UDim2.new(0, 332, 0, yPos)
    num.BackgroundTransparency = 1
    num.Text = tostring(math.floor(customRGB[chanKey] + 0.5))
    num.TextColor3 = T.text0
    num.Font = FONT_DISPLAY
    num.TextSize = 12
    num.TextXAlignment = Enum.TextXAlignment.Right
    num.TextYAlignment = Enum.TextYAlignment.Center
    num.ZIndex = 10
    num.Parent = parent

    local dragging = false

    local function setFromRel(rel)
        rel = math.clamp(rel, 0, 1)
        local val = math.floor(rel * 255 + 0.5)
        customRGB[chanKey] = val
        fill.Size = UDim2.new(rel, 0, 1, 0)
        handle.Position = UDim2.new(rel, -7, 0.5, -7)
        num.Text = tostring(val)
        updateRGBPreview()
    end

    local function updateFromMouseX(mx)
        local ap = track.AbsolutePosition
        local asz = track.AbsoluteSize
        if asz.X <= 0 then return end
        setFromRel((mx - ap.X) / asz.X)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateFromMouseX(UserInputService:GetMouseLocation().X)
        elseif input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromMouseX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromMouseX(UserInputService:GetMouseLocation().X)
        elseif input.UserInputType == Enum.UserInputType.Touch then
            updateFromMouseX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return {
        setValue = function(v)
            local rel = math.clamp(v / 255, 0, 1)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            handle.Position = UDim2.new(rel, -7, 0.5, -7)
            num.Text = tostring(math.floor(v + 0.5))
        end,
    }
end

