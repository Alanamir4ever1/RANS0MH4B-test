local function toggleFavorite(key)
    if not builtin[key] then return end
    if favOn[key] then
        favOn[key] = false
        builtin[key].ui.star.Text = "☆"
        builtin[key].ui.star.TextColor3 = T.text2
        for i, k in ipairs(favOrder) do
            if k == key then table.remove(favOrder, i); break end
        end
    else
        favOn[key] = true
        builtin[key].ui.star.Text = "★"
        builtin[key].ui.star.TextColor3 = T.warn
        table.insert(favOrder, key)
    end
    saveFavorites()
    renderFaves()
end

-- =========================================================
--  STATE MACHINE (defined early — used by tiles)
-- =========================================================

local S = { READY = "READY", LOADING = "LOADING", LOADED = "LOADED", ERROR = "ERROR" }

local function makeStateMachine(ui, labelText, readyHint, loadingHint, loadedHint, errorHint)
    local state = S.READY
    local dotsTask = nil

    local function stopDots()
        if dotsTask then pcall(function() task.cancel(dotsTask) end); dotsTask = nil end
    end

    local function setColors(c1, c2, h1, h2, strokeT)
        ui.btnGrad.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, c1), ColorSequenceKeypoint.new(1, c2) })
        ui.ovGrad.Color  = ColorSequence.new({ ColorSequenceKeypoint.new(0, h1), ColorSequenceKeypoint.new(1, h2) })
        tween(ui.btnStroke, { Transparency = strokeT or 0.3 }, 0.4)
    end

    local function setState(s)
        state = s; stopDots()
        if s == S.READY then
            ui.btnText.Text = labelText
            setColors(BTN.base1, BTN.base2, BTN.hov1, BTN.hov2, 0.75)
            ui.hint.Text = readyHint
            ui.hint.TextColor3 = T.text2
        elseif s == S.LOADING then
            setColors(BTN_LOADING[1], BTN_LOADING[2], BTN_LOADING[3], BTN_LOADING[4], 0.5)
            ui.hint.Text = loadingHint; ui.hint.TextColor3 = T.warn
            dotsTask = task.spawn(function()
                local n = 0
                while state == S.LOADING do
                    n = (n % 3) + 1
                    ui.btnText.Text = "LOADING" .. string.rep(".", n)
                    task.wait(0.3)
                end
            end)
        elseif s == S.LOADED then
            ui.btnText.Text = "INJECTED"
            setColors(BTN_LOADED[1], BTN_LOADED[2], BTN_LOADED[3], BTN_LOADED[4], 0.4)
            ui.hint.Text = loadedHint; ui.hint.TextColor3 = T.ember
        elseif s == S.ERROR then
            ui.btnText.Text = "RETRY"
            setColors(BTN_ERROR[1], BTN_ERROR[2], BTN_ERROR[3], BTN_ERROR[4], 0.4)
            ui.hint.Text = errorHint; ui.hint.TextColor3 = T.danger
        end
    end

    local sm = {
        get = function() return state end,
        set = setState,
        ready = function() setState(S.READY) end,
        loading = function() setState(S.LOADING) end,
        loaded = function() setState(S.LOADED) end,
        error = function() setState(S.ERROR) end,
        refresh = function()
            -- re-apply colors for current state without touching dots task
            if state == S.READY then
                setColors(BTN.base1, BTN.base2, BTN.hov1, BTN.hov2, 0.75)
                ui.hint.TextColor3 = T.text2
            elseif state == S.LOADING then
                setColors(BTN_LOADING[1], BTN_LOADING[2], BTN_LOADING[3], BTN_LOADING[4], 0.5)
                ui.hint.TextColor3 = T.warn
            elseif state == S.LOADED then
                setColors(BTN_LOADED[1], BTN_LOADED[2], BTN_LOADED[3], BTN_LOADED[4], 0.4)
                ui.hint.TextColor3 = T.ember
            elseif state == S.ERROR then
                setColors(BTN_ERROR[1], BTN_ERROR[2], BTN_ERROR[3], BTN_ERROR[4], 0.4)
                ui.hint.TextColor3 = T.danger
            end
        end,
    }
    setState(S.READY)
    return sm
end

