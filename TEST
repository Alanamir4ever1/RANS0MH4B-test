local function doInject(sm, url, labelName)
    local st = sm.get()
    if st == S.LOADING or st == S.LOADED then return end
    sm.loading()
    task.spawn(function()
        local ok, err = pcall(function()
            local content = fetchScript(url)
            loadstring(content)()
