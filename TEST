    btn.MouseButton1Up:Connect(function() H.tw(btn, {BackgroundTransparency=0}, 0.12) end)

    table.insert(H.registry, {ui = {slot = slot}, label = lbl, page = parent})

    local r = {slot=slot, button=btn, btnText=nl, hint=hl, g=g, sk=sk, o=og, star=star}
    return r
end

