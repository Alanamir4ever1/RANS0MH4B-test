local FOLDER       = "A90_HUB"
local CACHE_DIR    = FOLDER .. "/cache"
local FAV_FILE     = FOLDER .. "/favorites.json"
local HIST_FILE    = FOLDER .. "/history.json"
local SETTINGS_FILE= FOLDER .. "/settings.json"
local USER_FILE    = FOLDER .. "/user_scripts.json"

local FS = { ok = false }
do
    local hasW  = type(writefile) == "function"
    local hasR  = type(readfile)  == "function"
    local hasI  = type(isfile)    == "function"
    local hasMk = type(makefolder) == "function"
    local hasId = type(isfolder)  == "function"
    if hasW and hasR and hasI and hasMk and hasId then
        pcall(function()
            if not isfolder(FOLDER)    then makefolder(FOLDER)    end
            if not isfolder(CACHE_DIR) then makefolder(CACHE_DIR) end
        end)
        FS.ok = true
    end
end

local function fnvHash(s)
    local h = 2166136261
    for i = 1, #s do
        h = bit32.bxor(h, string.byte(s, i))
        h = (h * 16777619) % 4294967296
    end
    return string.format("%08x", h)
end

local function readJSON(path, default)
    if not FS.ok or not isfile(path) then return default end
    local ok, data = pcall(readfile, path)
    if not ok or not data or data == "" then return default end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(data) end)
    if not ok2 or type(decoded) ~= "table" then return default end
    return decoded
end

local function writeJSON(path, data)
    if not FS.ok then return end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if ok then pcall(writefile, path, encoded) end
end

local function saveCache(url, content)
    if not FS.ok then return end
    pcall(writefile, CACHE_DIR .. "/" .. fnvHash(url) .. ".lua", content)
end

local function getCache(url)
    if not FS.ok then return nil end
    local p = CACHE_DIR .. "/" .. fnvHash(url) .. ".lua"
    if not isfile(p) then return nil end
    local ok, data = pcall(readfile, p)
    if ok then return data end
    return nil
end

local function fetchScript(url)
    local ok, content = pcall(function() return game:HttpGet(url) end)
    if ok and content and content ~= "" then
        saveCache(url, content)
        return content
    end
    local cached = getCache(url)
    if cached then return cached end
    error("fetch failed and no cache")
end

