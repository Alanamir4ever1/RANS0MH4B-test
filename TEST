    if opts.onDelete then
        local d = Instance.new("TextButton")
        d.Size = UDim2.new(0,24,0,24); d.Position = UDim2.new(1,-56,0,6)
        d.BackgroundColor3 = T.s0; d.BackgroundTransparency = 0.25
