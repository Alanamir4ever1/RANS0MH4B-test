    end)
    btn.MouseButton1Down:Connect(function()
        tween(btn, { BackgroundTransparency = 0.15 }, 0.08)
    end)
    btn.MouseButton1Up:Connect(function()
        tween(btn, { BackgroundTransparency = 0 }, 0.12)
    end)

    table.insert(registry, { ui = { slot = slot }, label = labelText, page = parent })

    local result = {
        slot = slot, button = btn, btnText = nameLbl, hint = hintLbl,
        btnGrad = btnGrad, btnStroke = btnStroke, ovGrad = ovGrad, star = star,
    }

    star.MouseButton1Click:Connect(function() toggleFavorite(uniqueKey) end)

    return result
end

