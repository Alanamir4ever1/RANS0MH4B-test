-- FAVES
-- ============================================================
do
    local fs = Instance.new("ScrollingFrame")
    fs.Size = UDim2.new(1,-40,1,-8); fs.Position = UDim2.new(0,20,0,4)
    fs.BackgroundTransparency = 1; fs.BorderSizePixel = 0
    fs.ScrollBarThickness = 4; fs.ScrollBarImageColor3 = T.accent
    fs.CanvasSize = UDim2.new(0,0,0,0); fs.ZIndex = 8; fs.Parent = H.pages.FAVES
    H.onTheme(function() fs.ScrollBarImageColor3 = T.accent end)

    local fe = Instance.new("TextLabel")
    fe.Size = UDim2.new(1,0,0,40); fe.Position = UDim2.new(0,0,0,20)
    fe.BackgroundTransparency = 1
    fe.Text = "★ no favorites yet — tap the star on any tile"
    fe.TextColor3 = T.t3; fe.Font = H.FD; fe.TextSize = 12
    fe.ZIndex = 9; fe.Parent = fs

    H.renderFaves = function()
        for _, c in ipairs(fs:GetChildren()) do if c ~= fe then c:Destroy() end end
        if #H.favOrder == 0 then
            fe.Visible = true; fs.CanvasSize = UDim2.new(0,0,0,80); return
        end
        fe.Visible = false
        local y = 0
        for _, k in ipairs(H.favOrder) do
            local e = H.builtin[k]
            if e and H.favOn[k] then
                local r = Instance.new("TextButton")
                r.Size = UDim2.new(1,-8,0,40); r.Position = UDim2.new(0,4,0,y)
                r.BackgroundColor3 = T.s3; r.BackgroundTransparency = 0.15
                r.BorderSizePixel = 0; r.Text = ""; r.AutoButtonColor = false
                r.ZIndex = 9; r.Parent = fs; H.corner(r, 8)
                local rs = H.stroke(r, T.accent, 1, 0.6)
                H.onTheme(function() rs.Color = T.accent end)

                local st = Instance.new("TextLabel")
                st.Size = UDim2.new(0,30,1,0); st.Position = UDim2.new(0,6,0,0)
                st.BackgroundTransparency = 1; st.Text = "★"
                st.TextColor3 = T.warn; st.Font = H.FD
                st.TextSize = 16; st.ZIndex = 10; st.Parent = r

                local nm = Instance.new("TextLabel")
                nm.Size = UDim2.new(1,-90,1,0); nm.Position = UDim2.new(0,42,0,0)
                nm.BackgroundTransparency = 1; nm.Text = e.label
                nm.TextColor3 = T.t0; nm.Font = H.FD; nm.TextSize = 13
                nm.TextXAlignment = Enum.TextXAlignment.Left; nm.ZIndex = 10; nm.Parent = r

                local gb = Instance.new("TextButton")
                gb.Size = UDim2.new(0,40,1,-8); gb.Position = UDim2.new(1,-46,0,4)
                gb.BackgroundColor3 = T.accent; gb.BackgroundTransparency = 0.15
                gb.BorderSizePixel = 0; gb.Text = "▶"; gb.TextColor3 = T.t0
                gb.Font = H.FD; gb.TextSize = 14; gb.AutoButtonColor = false
                gb.ZIndex = 10; gb.Parent = r; H.corner(gb, 6)
                H.onTheme(function() gb.BackgroundColor3 = T.accent end)

                gb.MouseButton1Click:Connect(function() if e.run then task.spawn(e.run) end end)
                r.MouseButton1Click:Connect(function() if e.run then task.spawn(e.run) end end)
                y = y + 46
            end
        end
        fs.CanvasSize = UDim2.new(0,0,0,y+8)
    end

    H.saveFavorites = function() H.writeJ(H.F_FAV, {order = H.favOrder}) end
    H.loadFavorites = function()
        local d = H.readJ(H.F_FAV, nil)
        if type(d) == "table" and type(d.order) == "table" then
            for _, k in ipairs(d.order) do
                if H.builtin[k] then
                    H.favOn[k] = true
                    table.insert(H.favOrder, k)
                    if H.builtin[k].ui and H.builtin[k].ui.star then
                        H.builtin[k].ui.star.Text = "★"
                        H.builtin[k].ui.star.TextColor3 = T.warn
                    end
                end
            end
        end
    end
    H.toggleFavorite = function(k)
        if not H.builtin[k] then return end
        if H.favOn[k] then
            H.favOn[k] = false
            if H.builtin[k].ui.star then
                H.builtin[k].ui.star.Text = "☆"
                H.builtin[k].ui.star.TextColor3 = T.t2
            end
            for i, kk in ipairs(H.favOrder) do if kk == k then table.remove(H.favOrder, i); break end end
        else
            H.favOn[k] = true
            if H.builtin[k].ui.star then
                H.builtin[k].ui.star.Text = "★"
                H.builtin[k].ui.star.TextColor3 = T.warn
            end
            table.insert(H.favOrder, k)
        end
        H.saveFavorites(); H.renderFaves()
    end
end

