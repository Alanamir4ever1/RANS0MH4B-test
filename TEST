local function applySearchFilter()
    local q = string.lower(searchInput.Text)
    for _, entry in ipairs(registry) do
        if entry.ui.slot.Parent == pages[activeTab] then
            if q == "" then
                entry.ui.slot.Visible = true
            else
                entry.ui.slot.Visible = string.find(string.lower(entry.label), q, 1, true) ~= nil
            end
        end
    end
end

local function setTab(name)
    if activeTab == name then return end
    for _, tab in ipairs(TABS) do
        pages[tab.name].Visible = false
        local ic = tabIcons[tab.name]
        tween(ic.icon, { TextColor3 = T.text2 }, 0.2)
        tween(ic.label, { TextColor3 = T.text2 }, 0.2)
    end
    pages[name].Visible = true
    local ic = tabIcons[name]
    tween(ic.icon, { TextColor3 = T.text0 }, 0.2)
    tween(ic.label, { TextColor3 = T.text0 }, 0.2)

    for i, tab in ipairs(TABS) do
        if tab.name == name then slidePill(i); break end
    end

    activeTab = name
    for _, entry in ipairs(registry) do
        entry.ui.slot.Visible = true
    end
    applySearchFilter()
end

