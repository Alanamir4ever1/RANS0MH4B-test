local function panicWipe()
    local targets = {
        "infiniteyield", "iy", "dex", "hydroxide", "cmd-x", "cmd x",
        "kavo", "orion", "fluxus", "skid", "dark dex", "remotespy",
        "serverhop", "sirhurt", "synapse", "a-90", "a90",
    }
    local function tryKill(inst)
        local n = string.lower(inst.Name)
        for _, t in ipairs(targets) do
            if string.find(n, t, 1, true) then
                pcall(function() inst:Destroy() end)
                return
            end
        end
    end
    pcall(function()
        for _, c in ipairs(CoreGui:GetChildren()) do
            if c ~= gui then tryKill(c) end
        end
    end)
    pcall(function()
        local pg = LP:FindFirstChild("PlayerGui")
        if pg then for _, c in ipairs(pg:GetChildren()) do tryKill(c) end end
    end)
    pcall(function() gui:Destroy() end)
end

