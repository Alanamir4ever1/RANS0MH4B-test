    info.Size = UDim2.new(1,-40,0,18); info.Position = UDim2.new(0,20,0,4)
    info.BackgroundTransparency = 1
    info.Text = "SELECT SCRIPTS TO RUN ON HUB START"
    info.TextColor3 = T.t2; info.Font = H.FD; info.TextSize = 10
    info.TextXAlignment = Enum.TextXAlignment.Left; info.ZIndex = 9; info.Parent = H.pages.AUTO

    local scr = Instance.new("ScrollingFrame")
    scr.Size = UDim2.new(1,-40,1,-110); scr.Position = UDim2.new(0,20,0,26)
    scr.BackgroundColor3 = T.s0; scr.BackgroundTransparency = 0.4
    scr.BorderSizePixel = 0; scr.ScrollBarThickness = 3
    scr.ScrollBarImageColor3 = T.accent; scr.CanvasSize = UDim2.new(0,0,0,0)
    scr.ZIndex = 8; scr.Parent = H.pages.AUTO; H.corner(scr, 8)
    H.onTheme(function() scr.ScrollBarImageColor3 = T.accent end)
    H.autoScroll = scr

    local rb = Instance.new("TextButton")
    rb.Size = UDim2.new(1,-40,0,34); rb.Position = UDim2.new(0,20,1,-76)
    rb.BackgroundColor3 = T.accent; rb.BorderSizePixel = 0
    rb.Text = "▶ RUN SELECTED NOW"; rb.TextColor3 = Color3.new(1,1,1)
    rb.Font = H.FD; rb.TextSize = 13; rb.AutoButtonColor = false
    rb.ZIndex = 9; rb.Parent = H.pages.AUTO; H.corner(rb, 8)
    H.onTheme(function() rb.BackgroundColor3 = T.accent end)
    rb.MouseEnter:Connect(function() H.tw(rb, {BackgroundTransparency=0.1}, 0.15) end)
    rb.MouseLeave:Connect(function() H.tw(rb, {BackgroundTransparency=0}, 0.15) end)

    local clr = Instance.new("TextButton")
    clr.Size = UDim2.new(1,-40,0,30); clr.Position = UDim2.new(0,20,1,-38)
    clr.BackgroundColor3 = T.s3; clr.BackgroundTransparency = 0.3
    clr.BorderSizePixel = 0; clr.Text = "CLEAR AUTOLOAD LIST"
    clr.TextColor3 = T.t2; clr.Font = H.FD; clr.TextSize = 11
    clr.AutoButtonColor = false; clr.ZIndex = 9; clr.Parent = H.pages.AUTO; H.corner(clr, 6)
    clr.MouseEnter:Connect(function() H.tw(clr, {BackgroundTransparency=0, TextColor3=T.danger}, 0.15) end)
    clr.MouseLeave:Connect(function() H.tw(clr, {BackgroundTransparency=0.3, TextColor3=T.t2}, 0.15) end)

    H.saveAutoload = function()
        local out = {}
        for u in pairs(H.autoloadSet) do table.insert(out, u) end
        H.writeJ(H.F_AUTO, {urls = out})
    end

    H.renderAutoload = function()
        for _, c in ipairs(scr:GetChildren()) do c:Destroy() end
        local y = 4
        local h1 = Instance.new("TextLabel")
        h1.Size = UDim2.new(1,-8,0,16); h1.Position = UDim2.new(0,8,0,y)
        h1.BackgroundTransparency = 1; h1.Text = "BUILT-IN"
        h1.TextColor3 = T.aHi; h1.Font = H.FD; h1.TextSize = 10
        h1.TextXAlignment = Enum.TextXAlignment.Left; h1.ZIndex = 10; h1.Parent = scr
        H.onTheme(function() h1.TextColor3 = T.aHi end)
        y = y + 22

        local function row(ico, lbl, url, isUser)
            local r = Instance.new("Frame")
            r.Size = UDim2.new(1,-8,0,34); r.Position = UDim2.new(0,4,0,y)
            r.BackgroundColor3 = T.s2; r.BackgroundTransparency = 0.2
            r.BorderSizePixel = 0; r.ZIndex = 9; r.Parent = scr; H.corner(r, 6)

            local ck = Instance.new("TextButton")
            ck.Size = UDim2.new(0,24,0,24); ck.Position = UDim2.new(0,6,0,5)
            ck.BackgroundColor3 = T.s0; ck.BackgroundTransparency = 0.3
            ck.BorderSizePixel = 0
            ck.Text = H.autoloadSet[url] and "✓" or ""
            ck.TextColor3 = T.aHi; ck.Font = H.FD; ck.TextSize = 16
            ck.AutoButtonColor = false; ck.ZIndex = 10; ck.Parent = r; H.corner(ck, 6)
            H.onTheme(function() ck.TextColor3 = T.aHi end)

            local ic = Instance.new("TextLabel")
            ic.Size = UDim2.new(0,24,1,0); ic.Position = UDim2.new(0,36,0,0)
            ic.BackgroundTransparency = 1; ic.Text = ico
            ic.TextColor3 = Color3.new(1,1,1); ic.Font = H.FD
            ic.TextSize = 16; ic.ZIndex = 10; ic.Parent = r

            local nm = Instance.new("TextLabel")
            nm.Size = UDim2.new(1,-160,1,0); nm.Position = UDim2.new(0,66,0,0)
            nm.BackgroundTransparency = 1; nm.Text = lbl
            nm.TextColor3 = T.t0; nm.Font = H.FD; nm.TextSize = 12
            nm.TextXAlignment = Enum.TextXAlignment.Left
            nm.TextTruncate = Enum.TextTruncate.AtEnd; nm.ZIndex = 10; nm.Parent = r

            local tg = Instance.new("TextLabel")
            tg.Size = UDim2.new(0,60,1,0); tg.Position = UDim2.new(1,-66,0,0)
            tg.BackgroundTransparency = 1
            tg.Text = isUser and "USER" or "BUILTIN"
            tg.TextColor3 = isUser and T.emberHi or T.t3
            tg.Font = H.FD; tg.TextSize = 9
            tg.TextXAlignment = Enum.TextXAlignment.Right; tg.ZIndex = 10; tg.Parent = r

            local function tog()
                if H.autoloadSet[url] then H.autoloadSet[url] = nil; ck.Text = ""
                else H.autoloadSet[url] = true; ck.Text = "✓" end
                H.saveAutoload()
            end
            ck.MouseButton1Click:Connect(tog)
            r.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                local mp = H.UI:GetMouseLocation()
                local cp = ck.AbsolutePosition; local cs = ck.AbsoluteSize
                if mp.X < cp.X or mp.X > cp.X + cs.X or mp.Y < cp.Y or mp.Y > cp.Y + cs.Y then
                    tog()
                end
            end)
            r.Active = true
            y = y + 38
        end

        for _, k in ipairs({"iy","fly","skin","abysall","cheesy","msdoors","dex","hydro","cmdx"}) do
            local e = H.builtin[k]
            if e then row(e.icon, e.label, e.url, false) end
        end
        y = y + 8
        local h2 = Instance.new("TextLabel")
        h2.Size = UDim2.new(1,-8,0,16); h2.Position = UDim2.new(0,8,0,y)
        h2.BackgroundTransparency = 1; h2.Text = "YOUR SCRIPTS"
        h2.TextColor3 = T.emberHi; h2.Font = H.FD; h2.TextSize = 10
        h2.TextXAlignment = Enum.TextXAlignment.Left; h2.ZIndex = 10; h2.Parent = scr
        H.onTheme(function() h2.TextColor3 = T.emberHi end)
        y = y + 22

        if #H.userScripts == 0 then
            local emp = Instance.new("TextLabel")
            emp.Size = UDim2.new(1,-8,0,24); emp.Position = UDim2.new(0,8,0,y)
            emp.BackgroundTransparency = 1
            emp.Text = "> no user scripts yet — add them in USER tab"
            emp.TextColor3 = T.t3; emp.Font = H.FD; emp.TextSize = 10
            emp.TextXAlignment = Enum.TextXAlignment.Left; emp.ZIndex = 10; emp.Parent = scr
            y = y + 28
        else
            for _, e in ipairs(H.userScripts) do row(e.icon, e.name, e.url, true) end
        end
        scr.CanvasSize = UDim2.new(0,0,0,y+8)
    end

    clr.MouseButton1Click:Connect(function()
        H.autoloadSet = {}; H.saveAutoload(); H.renderAutoload()
    end)
    rb.MouseButton1Click:Connect(function()
        for url in pairs(H.autoloadSet) do
            task.spawn(function()
                local ok, err = pcall(function() loadstring(H.fetch(url))() end)
                if not ok then warn("[A-90 autoload] "..tostring(err)) end
            end)
            task.wait(0.15)
        end
    end)
end

