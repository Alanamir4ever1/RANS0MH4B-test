        iconLbl.ZIndex = 13
        iconLbl.Parent = content

        local nameLbl = Instance.new("TextLabel")
        nameLbl.AutomaticSize = Enum.AutomaticSize.X
        nameLbl.Size = UDim2.new(0, 0, 1, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = entry.name or "CUSTOM"
        nameLbl.TextColor3 = Color3.new(1,1,1)
        nameLbl.Font = FONT_DISPLAY
        nameLbl.TextSize = 16
        nameLbl.LayoutOrder = 2
        nameLbl.ZIndex = 13
        nameLbl.Parent = content

        local hintLbl = Instance.new("TextLabel")
        hintLbl.Size = UDim2.new(1, 0, 0, 16)
        hintLbl.Position = UDim2.new(0, 0, 0, tileH + 2)
        hintLbl.BackgroundTransparency = 1
