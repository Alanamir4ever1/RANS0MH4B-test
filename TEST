            H.CC = nil
            H.applyTheme(key)
        end)

        H.themeButtons[key] = {btn = b, check = ck, stroke = bs, swatch = sw}
    end

    -- RGB
    local rt = Instance.new("TextLabel")
    rt.Size = UDim2.new(1,0,0,16); rt.Position = UDim2.new(0,0,0,158)
    rt.BackgroundTransparency = 1; rt.Text = "CUSTOM ACCENT COLOR"
    rt.TextColor3 = T.t2; rt.Font = H.FD; rt.TextSize = 10
    rt.TextXAlignment = Enum.TextXAlignment.Left; rt.ZIndex = 9; rt.Parent = wrap

    local cp = Instance.new("Frame")
    cp.Size = UDim2.new(0,60,0,40); cp.Position = UDim2.new(0,0,0,180)
    cp.BackgroundColor3 = Color3.fromRGB(128,128,128); cp.BorderSizePixel = 0
    cp.ZIndex = 9; cp.Parent = wrap; H.corner(cp, 8)
    H.stroke(cp, Color3.new(1,1,1), 1, 0.6)

    H.rgb = {r = 230, g = 45, b = 60}

    local function updatePrev()
        cp.BackgroundColor3 = Color3.fromRGB(H.rgb.r, H.rgb.g, H.rgb.b)
    end
    H.updateRGB = updatePrev
    updatePrev()

    local function slider(y, ch, colr)
        local holder = Instance.new("Frame")
        holder.Size = UDim2.new(0,500,0,22); holder.Position = UDim2.new(0,80,0,y)
        holder.BackgroundTransparency = 1; holder.ZIndex = 9; holder.Parent = wrap

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0,20,1,0); lbl.Position = UDim2.new(0,0,0,0)
        lbl.BackgroundTransparency = 1; lbl.Text = ch:upper()
        lbl.TextColor3 = colr; lbl.Font = H.FD
        lbl.TextSize = 11; lbl.ZIndex = 10; lbl.Parent = holder

        local tr = Instance.new("Frame")
        tr.Size = UDim2.new(1,-60,0,10); tr.Position = UDim2.new(0,20,0,6)
        tr.BackgroundColor3 = T.s2; tr.BorderSizePixel = 0
        tr.ZIndex = 9; tr.Parent = holder; H.corner(tr, 5)
        H.grad(tr, {Color3.new(0,0,0), colr}, 0)

        local fm = Instance.new("Frame")
        fm.Size = UDim2.new(0,3,1,0); fm.Position = UDim2.new(H.rgb[ch]/255, -1.5, 0, 0)
        fm.BackgroundColor3 = Color3.new(1,1,1); fm.BorderSizePixel = 0
        fm.ZIndex = 11; fm.Parent = tr

        local vl = Instance.new("TextLabel")
        vl.Size = UDim2.new(0,36,1,0); vl.Position = UDim2.new(1,-38,0,0)
        vl.BackgroundTransparency = 1; vl.Text = tostring(H.rgb[ch])
        vl.TextColor3 = T.t0; vl.Font = H.FD
        vl.TextSize = 11; vl.ZIndex = 10; vl.Parent = holder

        local dg = false
        local function setFromX(x)
            local ap = tr.AbsolutePosition
            local w = tr.AbsoluteSize.X
            local rel = math.clamp((x - ap.X) / w, 0, 1)
            local v = math.floor(rel * 255 + 0.5)
            H.rgb[ch] = v
            fm.Position = UDim2.new(rel, -1.5, 0, 0)
            vl.Text = tostring(v)
            updatePrev()
        end
        tr.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dg = true; setFromX(input.Position.X)
            end
        end)
        tr.InputChanged:Connect(function(input)
            if dg and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                setFromX(input.Position.X)
            end
        end)
        H.UI.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then dg = false end
        end)
    end

    slider(180, "r", Color3.fromRGB(230,60,60))
    slider(202, "g", Color3.fromRGB(60,220,60))
    slider(224, "b", Color3.fromRGB(60,130,230))

    local ap = Instance.new("TextButton")
    ap.Size = UDim2.new(0,220,0,32); ap.Position = UDim2.new(1,-220,0,180)
    ap.BackgroundColor3 = T.accent; ap.BorderSizePixel = 0
