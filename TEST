local function loadHistory()
    history = {}
    local data = readJSON(HIST_FILE, nil)
    if type(data) == "table" and type(data.items) == "table" then
        for _, e in ipairs(data.items) do
            if type(e) == "table" and type(e.url) == "string" then
                table.insert(history, { url = e.url, ok = e.ok and true or false })
            end
        end
    end
    renderHistory()
end

local function pushHistory(url, ok)
    for i, e in ipairs(history) do
        if e.url == url then table.remove(history, i); break end
    end
    table.insert(history, 1, { url = url, ok = ok })
    while #history > 20 do table.remove(history) end
    saveHistory()
    renderHistory()
end

