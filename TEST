function H.hash(s)
    local h = 2166136261
    for i=1,#s do h = bit32.bxor(h, string.byte(s,i)); h = (h*16777619) % 4294967296 end
    return string.format("%08x", h)
end
function H.readJ(p, d)
    if not H.FS or not isfile(p) then return d end
    local ok, data = pcall(readfile, p)
    if not ok or not data or data=="" then return d end
    local ok2, dec = pcall(function() return H.Ht:JSONDecode(data) end)
    return ok2 and type(dec)=="table" and dec or d
end
function H.writeJ(p, d)
    if not H.FS then return end
    local ok, enc = pcall(function() return H.Ht:JSONEncode(d) end)
    if ok then pcall(writefile, p, enc) end
end
function H.fetch(url)
    local ok, c = pcall(function() return game:HttpGet(url) end)
    if ok and c and c~="" then
        if H.FS then pcall(writefile, H.CACHE.."/"..H.hash(url)..".lua", c) end
        return c
    end
    if H.FS then
        local p = H.CACHE.."/"..H.hash(url)..".lua"
        if isfile(p) then
            local ok2, c2 = pcall(readfile, p)
            if ok2 then return c2 end
        end
    end
    error("fetch failed")
end

