function H.corner(i, r) local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,r); c.Parent = i; return c end
function H.stroke(i, col, tk, tr)
    local s = Instance.new("UIStroke"); s.Color = col or Color3.new(1,1,1)
    s.Thickness = tk or 1; s.Transparency = tr or 0; s.Parent = i; return s
end
function H.tw(i, p, d, st, di)
    local info = TweenInfo.new(d or 0.2, st or Enum.EasingStyle.Quart, di or Enum.EasingDirection.Out)
    local t = H.Tw:Create(i, info, p); t:Play(); return t
end
function H.grad(i, cols, rot, tr)
    local g = Instance.new("UIGradient"); local kp = {}
    for a,c in ipairs(cols) do table.insert(kp, ColorSequenceKeypoint.new((a-1)/(#cols-1), c)) end
    g.Color = ColorSequence.new(kp); g.Rotation = rot or 0
    if tr then
        local tp = {}
        for a,tv in ipairs(tr) do table.insert(tp, NumberSequenceKeypoint.new((a-1)/(#tr-1), tv)) end
        g.Transparency = NumberSequence.new(tp)
    end
    g.Parent = i; return g
end
H.GC = "!@#$%^&*<>?/\\|=+~0123456789ABCDEF"
function H.scr(txt, cnt)
    cnt = cnt or 1; local ch = {}
    for i=1,#txt do ch[i] = txt:sub(i,i) end
    for _=1,cnt do
        local k = math.random(1,#ch)
        if ch[k]~=" " then ch[k] = H.GC:sub(math.random(1,#H.GC), math.random(1,#H.GC)) end
    end
    return table.concat(ch)
end

