local function saveUserScripts()
    local out = {}
    for _, e in ipairs(userScripts) do
        table.insert(out, { name = e.name, icon = e.icon, url = e.url })
    end
    writeJSON(USER_FILE, { scripts = out })
end

local renderUserScripts  -- forward decl

local function deleteUserScript(idx)
    local entry = userScripts[idx]
    if not entry then return end
    if entry.ui and entry.ui.slot then entry.ui.slot:Destroy() end
    table.remove(userScripts, idx)
    saveUserScripts()
    renderUserScripts()
end

renderUserScripts = function()
    for _, c in ipairs(userScroll:GetChildren()) do
        if c ~= userEmpty then c:Destroy() end
    end

    if #userScripts == 0 then
        userEmpty.Visible = true
        userScroll.CanvasSize = UDim2.new(0, 0, 0, 80)
        return
    end
    userEmpty.Visible = false

    -- lay tiles in a 3-column grid inside userScroll
    local cols = 3
    local pad = 20
    local gap = 12
    local tileW = 213
    local tileH = 110
    local rowGap = 12

    for i, entry in ipairs(userScripts) do
        local col = ((i - 1) % cols) + 1
        local row = math.floor((i - 1) / cols) + 1
        local xPos = pad + (col - 1) * (tileW + gap)
        local yPos = pad + (row - 1) * (tileH + rowGap + 18)

        local slot = Instance.new("Frame")
        slot.Size = UDim2.new(0, tileW, 0, tileH + 18)
        slot.Position = UDim2.new(0, xPos, 0, yPos)
        slot.BackgroundTransparency = 1
        slot.ZIndex = 8
        slot.Parent = userScroll

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, tileH)
        btn.BackgroundColor3 = Color3.new(1,1,1)
        btn.BorderSizePixel = 0
        btn.Text = ""
        btn.AutoButtonColor = false
        btn.ClipsDescendants = true
        btn.ZIndex = 8
        btn.Parent = slot
        corner(btn, 14)

        local btnGrad = grad(btn, { BTN.base1, BTN.base2 }, 135); btnGrad.Parent = btn
        local btnStroke = stroke(btn, Color3.new(1,1,1), 1, 0.75)

        local overlay = Instance.new("Frame")
        overlay.Size = UDim2.new(1,0,1,0)
        overlay.BackgroundColor3 = Color3.new(1,1,1)
        overlay.BackgroundTransparency = 1
        overlay.BorderSizePixel = 0
        overlay.ZIndex = 10
        overlay.Parent = btn
        corner(overlay, 14)
        local ovGrad = grad(overlay, { BTN.hov1, BTN.hov2 }, 135); ovGrad.Parent = overlay

        local shine = Instance.new("Frame")
