    end)

    -- Data buttons
    local dt = Instance.new("TextLabel")
    dt.Size = UDim2.new(1,0,0,14); dt.Position = UDim2.new(0,0,0,268)
    dt.BackgroundTransparency = 1; dt.Text = "DATA MANAGEMENT"
    dt.TextColor3 = T.t2; dt.Font = H.FD; dt.TextSize = 10
    dt.TextXAlignment = Enum.TextXAlignment.Left; dt.ZIndex = 9; dt.Parent = wrap

    local function dataBtn(x, y, w, txt, fn)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0,w,0,30); b.Position = UDim2.new(0,x,0,y)
        b.BackgroundColor3 = T.s2; b.BackgroundTransparency = 0.3
        b.BorderSizePixel = 0; b.Text = txt; b.TextColor3 = T.t1
        b.Font = H.FD; b.TextSize = 11; b.AutoButtonColor = false
