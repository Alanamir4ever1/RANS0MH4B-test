local function makeRGBSlider(parent, yPos, labelText, channelColor, chanKey)
    local rowH = 30

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0, 18, 0, rowH)
    lbl.Position = UDim2.new(0, 0, 0, yPos)
