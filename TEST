    cf.Size = UDim2.new(1,0,0,14); cf.Position = UDim2.new(0,0,0,362)
    cf.BackgroundTransparency = 1; cf.Text = "CONFIG"
    cf.TextColor3 = T.t2; cf.Font = H.FD; cf.TextSize = 10
    cf.TextXAlignment = Enum.TextXAlignment.Left; cf.ZIndex = 9; cf.Parent = wrap

