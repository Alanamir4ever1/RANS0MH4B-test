H.panicWipe = function()
    local targets = {"infiniteyield","iy","dex","hydroxide","cmd-x","cmd x","kavo","orion","fluxus","skid","dark dex","remotespy","serverhop","sirhurt","synapse","a-90","a90"}
    local function kill(i)
        local n = string.lower(i.Name)
        for _, t in ipairs(targets) do
            if string.find(n, t, 1, true) then pcall(function() i:Destroy() end); return end
        end
    end
    pcall(function()
        for _, c in ipairs(H.CG:GetChildren()) do if c ~= H.gui then kill(c) end end
    end)
    pcall(function()
        local pg = H.LP:FindFirstChild("PlayerGui")
        if pg then for _, c in ipairs(pg:GetChildren()) do kill(c) end end
    end)
    pcall(function() H.gui:Destroy() end)
end

