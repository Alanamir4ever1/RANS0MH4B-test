-- drag loop
H.RS.RenderStepped:Connect(function()
    local ds = H.dragState
    if not ds then return end
    local mp = H.UI:GetMouseLocation()
    local dx = mp.X - ds.startMouse.X
    local dy = mp.Y - ds.startMouse.Y
    if math.abs(dx) > 4 or math.abs(dy) > 4 then ds.moved = true end
    if ds.moved then
        ds.slot.ZIndex = 300
        ds.slot.Position = UDim2.new(0, ds.startPos.X.Offset + dx, 0, ds.startPos.Y.Offset + dy)
        ds.btn.BackgroundTransparency = 0.25
    end
end)

H.UI.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
    and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local ds = H.dragState
    if not ds then return end
    local wasMoved = ds.moved
    local srcIdx = ds.idx
    ds.btn.BackgroundTransparency = 0; ds.slot.ZIndex = 8
    if wasMoved then
        local mouse = H.UI:GetMouseLocation()
        local sa = H.userScroll.AbsolutePosition
        local sy = H.userScroll.CanvasPosition.Y or 0
        local relX = mouse.X - sa.X
        local relY = mouse.Y - sa.Y + sy
        local pad, gap, tW, tH, rG = 20, 12, 213, 110, 12
        local col = math.clamp(math.floor((relX-pad)/(tW+gap))+1, 1, 3)
        local row = math.max(math.floor((relY-pad)/(tH+rG+18))+1, 1)
        local target = math.clamp((row-1)*3 + col, 1, #H.userScripts)
        if target ~= srcIdx then
            local e = table.remove(H.userScripts, srcIdx)
            table.insert(H.userScripts, target, e)
            H.saveUserScripts()
        end
    end
    H.dragState = nil
    H.renderUserScripts()
end)

