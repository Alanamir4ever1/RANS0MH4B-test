    star.BorderSizePixel = 0; star.Text = "☆"; star.TextColor3 = T.t2
    star.Font = H.FD; star.TextSize = 14; star.AutoButtonColor = false
    star.ZIndex = 15; star.Parent = btn; H.corner(star, 6)
    star.MouseEnter:Connect(function() H.tw(star, {BackgroundTransparency=0}, 0.15) end)
    star.MouseLeave:Connect(function() H.tw(star, {BackgroundTransparency=0.25}, 0.15) end)
