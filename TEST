H.setTab = function(name)
    if H.activeTab == name then return end
    for _, tab in ipairs(H.TABS) do
        H.pages[tab.name].Visible = false
        local ic = H.tabIcons[tab.name]
        H.tw(ic.icon, {TextColor3 = T.t2}, 0.2)
        H.tw(ic.label, {TextColor3 = T.t2}, 0.2)
    end
    H.pages[name].Visible = true
    local ic = H.tabIcons[name]
    H.tw(ic.icon, {TextColor3 = T.t0}, 0.2)
    H.tw(ic.label, {TextColor3 = T.t0}, 0.2)
    for i, tab in ipairs(H.TABS) do
        if tab.name == name then
            H.tw(H.pill, {Position = UDim2.new(0, (i-1)*H.TAB_W + 4, 0, 4)}, 0.35, Enum.EasingStyle.Quart)
            break
        end
    end
    H.activeTab = name
    for _, e in ipairs(H.registry) do e.ui.slot.Visible = true end
    local q = string.lower(H.searchInput.Text)
    if q ~= "" then
        for _, e in ipairs(H.registry) do
            if e.ui.slot.Parent == H.pages[name] or e.ui.slot.Parent == H.userScroll then
                e.ui.slot.Visible = string.find(string.lower(e.label), q, 1, true) ~= nil
            end
        end
    end
end

for _, tab in ipairs(H.TABS) do
    H.tabButtons[tab.name].MouseButton1Click:Connect(function() H.setTab(tab.name) end)
end

H.searchInput:GetPropertyChangedSignal("Text"):Connect(function()
    local q = string.lower(H.searchInput.Text)
    for _, e in ipairs(H.registry) do
        if e.ui.slot.Parent == H.pages[H.activeTab] or e.ui.slot.Parent == H.userScroll then
            if q == "" then e.ui.slot.Visible = true
            else e.ui.slot.Visible = string.find(string.lower(e.label), q, 1, true) ~= nil end
        end
    end
end)

