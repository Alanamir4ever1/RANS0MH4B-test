--  DRAG & DROP STATE (USER tab)
-- =========================================================

local userDrag = {
    active = false,
    idx = nil,
    slot = nil,
    startMouse = Vector2.new(0, 0),
    startX = 0,
    startY = 0,
    moved = false,
    conn = nil,
}

local function startUserDrag(idx, slot)
    userDrag.active = true
    userDrag.idx = idx
    userDrag.slot = slot
    userDrag.moved = false
    userDrag.startMouse = UserInputService:GetMouseLocation()
    userDrag.startX = slot.Position.X.Offset
    userDrag.startY = slot.Position.Y.Offset

    if userDrag.conn then userDrag.conn:Disconnect() end
    userDrag.conn = RunService.RenderStepped:Connect(function()
        if not userDrag.active or not userDrag.slot then return end
        local mp = UserInputService:GetMouseLocation()
        local dx = mp.X - userDrag.startMouse.X
        local dy = mp.Y - userDrag.startMouse.Y
        if not userDrag.moved then
            if math.abs(dx) > 4 or math.abs(dy) > 4 then
                userDrag.moved = true
                userDrag.slot.ZIndex = 100
                tween(userDrag.slot, { BackgroundTransparency = 0.15 }, 0.15)
            end
        end
        if userDrag.moved then
            userDrag.slot.Position = UDim2.new(0, userDrag.startX + dx, 0, userDrag.startY + dy)
        end
    end)
end

local function finishUserDrag(release)
    if not userDrag.active then return end
    if userDrag.conn then userDrag.conn:Disconnect(); userDrag.conn = nil end

    local idx   = userDrag.idx
    local slot  = userDrag.slot
    local moved = userDrag.moved

    userDrag.active = false
    userDrag.idx = nil
    userDrag.slot = nil
    userDrag.moved = false

    if not moved then
        if release and idx and userScripts[idx] then
            local mp = UserInputService:GetMouseLocation()
            local ap = slot.AbsolutePosition
            local asz = slot.AbsoluteSize
            local isOver = mp.X >= ap.X and mp.X <= ap.X + asz.X
                       and mp.Y >= ap.Y and mp.Y <= ap.Y + asz.Y
            if isOver then
                local entry = userScripts[idx]
                if entry.sm then
                    doInject(entry.sm, entry.url, entry.name or "Custom")
                end
            end
        end
        return
    end

    local centerX = slot.AbsolutePosition.X + slot.AbsoluteSize.X * 0.5
    local centerY = slot.AbsolutePosition.Y + slot.AbsoluteSize.Y * 0.5
    local newIdx = idx
    for i, e in ipairs(userScripts) do
        if e.ui and e.ui.slot and e.ui.slot ~= slot then
            local s = e.ui.slot
            local sp = s.AbsolutePosition
            local ss = s.AbsoluteSize
            if centerX >= sp.X and centerX <= sp.X + ss.X
            and centerY >= sp.Y and centerY <= sp.Y + ss.Y then
                newIdx = i
                break
            end
        end
    end

    if release and newIdx ~= idx then
        local movedEntry = table.remove(userScripts, idx)
        table.insert(userScripts, newIdx, movedEntry)
        saveUserScripts()
    end

    for _, e in ipairs(userScripts) do
        if e.ui and e.ui.slot then e.ui.slot:Destroy() end
        e.ui = nil
        e.sm = nil
    end
    renderUserScripts()
end

