        hintLbl.TextColor3 = T.text2
        hintLbl.Font = FONT_BODY
        hintLbl.TextSize = 12
        hintLbl.TextXAlignment = Enum.TextXAlignment.Center
        hintLbl.TextTruncate = Enum.TextTruncate.AtEnd
        hintLbl.ZIndex = 8
        hintLbl.Parent = slot

        -- delete button
        local del = Instance.new("TextButton")
        del.Size = UDim2.new(0, 24, 0, 24); del.Position = UDim2.new(1, -28, 0, 6)
        del.BackgroundColor3 = T.surface0; del.BackgroundTransparency = 0.25
        del.BorderSizePixel = 0; del.Text = "×"; del.TextColor3 = T.text2
        del.Font = FONT_DISPLAY; del.TextSize = 16; del.AutoButtonColor = false
        del.ZIndex = 15; del.Parent = btn
        corner(del, 6)
        del.MouseEnter:Connect(function() tween(del, { BackgroundTransparency = 0, TextColor3 = T.danger }, 0.15) end)
        del.MouseLeave:Connect(function() tween(del, { BackgroundTransparency = 0.25, TextColor3 = T.text2 }, 0.15) end)
        del.MouseButton1Click:Connect(function() deleteUserScript(i) end)

        local sm = makeStateMachine({ btnGrad = btnGrad, ovGrad = ovGrad, btnStroke = btnStroke,
            btnText = nameLbl, hint = hintLbl },
            entry.name or "CUSTOM", "> click to inject", "> loading...", "> active", "> failed")

        entry.ui = { slot = slot, button = btn, btnText = nameLbl, hint = hintLbl,
            btnGrad = btnGrad, btnStroke = btnStroke, ovGrad = ovGrad }
        entry.sm = sm

        btn.MouseEnter:Connect(function()
            tween(overlay, { BackgroundTransparency = 0 }, 0.25)
            tween(btnStroke, { Transparency = 0.3 }, 0.25)
            shine.Position = UDim2.new(0, -100, -0.5, 0)
            tween(shine, { Position = UDim2.new(1, 40, -0.5, 0) }, 0.7, Enum.EasingStyle.Quad)
        end)
        btn.MouseLeave:Connect(function()
            tween(overlay, { BackgroundTransparency = 1 }, 0.25)
            tween(btnStroke, { Transparency = 0.75 }, 0.25)
        end)
        btn.MouseButton1Down:Connect(function()
            tween(btn, { BackgroundTransparency = 0.15 }, 0.08)
        end)
        btn.MouseButton1Up:Connect(function()
            tween(btn, { BackgroundTransparency = 0 }, 0.12)
        end)

        btn.MouseButton1Down:Connect(function()
            startUserDrag(i, slot)
        end)

        table.insert(registry, { ui = { slot = slot }, label = entry.name or "CUSTOM", page = userScroll })
    end

    local totalRows = math.ceil(#userScripts / 3)
    local canvasH = 20 + totalRows * (110 + 12 + 18) + 20
    userScroll.CanvasSize = UDim2.new(0, 0, 0, canvasH)
end

local function loadUserScripts()
    local data = readJSON(USER_FILE, nil)
    if type(data) == "table" and type(data.scripts) == "table" then
        for _, e in ipairs(data.scripts) do
            if type(e) == "table" and type(e.url) == "string" then
                table.insert(userScripts, {
                    name = tostring(e.name or "CUSTOM"),
                    icon = tostring(e.icon or "★"),
                    url = tostring(e.url),
                })
            end
        end
    end
    renderUserScripts()
end

