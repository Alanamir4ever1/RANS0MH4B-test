local function saveSettings()
    writeJSON(SETTINGS_FILE, { theme = currentTheme, customRGB = customRGB })
end

local function loadSettings()
    local data = readJSON(SETTINGS_FILE, nil)
    if type(data) == "table" then
        if type(data.theme) == "string" then
            if data.theme == "custom" or THEMES[data.theme] then
                currentTheme = data.theme
            end
        end
        if type(data.customRGB) == "table" then
            customRGB.r = tonumber(data.customRGB.r) or customRGB.r
            customRGB.g = tonumber(data.customRGB.g) or customRGB.g
            customRGB.b = tonumber(data.customRGB.b) or customRGB.b
        end
    end
    THEMES.custom = buildCustomTheme(customRGB.r, customRGB.g, customRGB.b)
end

-- =========================================================
--  APPLY THEME
-- =========================================================

function applyTheme(name)
    local theme = THEMES[name] or THEMES.red
    currentTheme = name
    T.accent     = theme.accent
    T.accentHi   = theme.accentHi
    T.accentGlow = theme.accentGlow
    T.accentDeep = theme.accentDeep
    T.accentEdge = theme.accentEdge
    T.ember      = theme.ember
    T.emberHi    = theme.emberHi

    BTN.base1 = T.accent
    BTN.base2 = T.accentDeep
    BTN.hov1  = T.accentHi
    BTN.hov2  = T.emberHi

    BTN_LOADING[1] = T.surface3
    BTN_LOADING[2] = T.surface2
    BTN_LOADING[3] = T.accent
    BTN_LOADING[4] = T.ember

    BTN_LOADED[1] = T.ember
    BTN_LOADED[2] = T.accent
    BTN_LOADED[3] = T.accentHi
    BTN_LOADED[4] = T.emberHi

    BTN_ERROR[1] = T.accentDeep
    BTN_ERROR[2] = T.surface0
    BTN_ERROR[3] = T.danger
    BTN_ERROR[4] = T.accentDeep

    for _, fn in ipairs(themeAppliers) do pcall(fn) end

    -- refresh all state machines
    for _, entry in pairs(builtin) do
        if entry.sm then entry.sm.refresh() end
    end
    for _, entry in ipairs(userScripts) do
        if entry.sm then entry.sm.refresh() end
    end

    saveSettings()
end

