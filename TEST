H.saveSettings = function()
    H.writeJ(H.F_SET, {theme = H.CT, customColor = H.CC})
end

H.loadSettings = function()
    local d = H.readJ(H.F_SET, nil)
    if type(d) == "table" then
        if type(d.theme) == "string" and H.THEMES[d.theme] then H.CT = d.theme end
        if type(d.customColor) == "table" and d.customColor.r then
            H.CC = d.customColor
            H.rgb.r = d.customColor.r; H.rgb.g = d.customColor.g; H.rgb.b = d.customColor.b
            if H.updateRGB then H.updateRGB() end
            H.THEMES.custom = H.buildCustomTheme(Color3.fromRGB(H.rgb.r, H.rgb.g, H.rgb.b))
        end
    end
end

H.applyTheme = function(name)
    local th = H.THEMES[name] or H.THEMES.red
    H.CT = name
    T.accent = th.accent; T.aHi = th.aHi; T.aGlow = th.aGlow
    T.aDeep = th.aDeep; T.aEdge = th.aEdge; T.ember = th.ember; T.emberHi = th.emberHi
    for _, fn in ipairs(H.themeAppliers) do pcall(fn) end
    for _, e in pairs(H.builtin) do if e.sm then e.sm.refresh() end end
    for _, e in ipairs(H.userScripts) do if e.sm then e.sm.refresh() end end
    H.saveSettings()
end

